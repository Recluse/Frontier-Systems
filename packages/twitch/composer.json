{
  "name": "frontier-systems/twitch",
  "description": "Optional asynchronous Twitch adapters for Frontier Systems.",
  "type": "library", "license": "MIT",
  "require": {"php": "^8.3", "react/http": "^1.9", "react/promise": "^3.0", "psr/http-message": "^1.1 || ^2.0", "frontier-systems/server-status": "^0.1@dev"},
  "repositories": [
    {"type": "path", "url": "../server-status", "options": {"symlink": false, "versions": {"frontier-systems/server-status": "0.1.x-dev"}}},
    {"type": "path", "url": "../world-contracts", "options": {"symlink": false, "versions": {"frontier-systems/world-contracts": "0.1.x-dev"}}}
  ],
  "minimum-stability": "dev", "prefer-stable": true,
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"Frontier\\Twitch\\": "src/"}},
  "autoload-dev": {"psr-4": {"Frontier\\Twitch\\Tests\\": "tests/"}},
  "scripts": {"unit": "phpunit --bootstrap tests/bootstrap.php tests"}
}

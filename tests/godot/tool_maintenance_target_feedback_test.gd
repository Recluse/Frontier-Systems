extends "res://tests/godot/player_inventory_components_test.gd"

## Real panel repair commands through fixed host ticks; no sockets or services.
func run() -> void:
	world = WorldRuntime.new()
	world.resource_carriers_enabled = true
	root.add_child(world)
	check(world.start_simulation().is_success, "damage fixture starts")
	world.get_node("SimulationRunner").set_physics_process(false)
	var saved: Dictionary = JSON.parse_string(world.capture_world_snapshot_json().value)
	var assembly: Dictionary = saved["systems"]["tools"]["ledger"]["assemblies"]["extractor-1"]
	var head: String = assembly["slots"]["head"]
	var other: String = assembly["slots"]["frame"]
	world.free()
	# Damage exists only in detached fixture records, never a presentation action.
	for id: String in [head, other]: saved["systems"]["tools"]["ledger"]["parts"][id]["integrity_ppm"] = 500001
	world = WorldRuntime.new()
	world.resource_carriers_enabled = true
	root.add_child(world)
	check(world.restore_world_snapshot_json(JSON.stringify(saved)).is_success and world.start_simulation().is_success, "damaged world restores")
	world.get_node("SimulationRunner").set_physics_process(false)
	world.command_completed.connect(func(_request: SimulationCommand, result: ServiceResult) -> void: last = result)
	context = AuthenticatedCommandContext.for_local_development(&"local-inventory-actor", world.world_id, world.region_id)
	remote = RecordingRemote.new()
	root.add_child(remote)
	panel = PlayerInventoryPanel.new()
	root.add_child(panel)
	panel.configure(remote)
	panel.observe(frame())
	select_tool("extractor-1")
	choose(panel._tool_parts, head)
	choose(panel._tool_mounts, "head")
	panel._update_buttons()
	check(panel._maintenance_targets.text.contains("restore 499999 ppm") and panel._maintenance_targets.text.contains("material stock required: none"), "actual panel shows current repair quote")
	var before: Dictionary = frame()
	panel._repair_component()
	var request: SimulationCommand = remote.sent[-1]
	check(panel._result.text.contains("Part ID: " + head) and panel._result.text.contains("Requested repair ppm: 1000000"), "repair pending pins exact component and amount")
	check(frame() == before, "repair intent does not mutate before host tick")
	var pending_text: String = panel._result.text
	var detached: Dictionary = before.duplicate(true)
	detached["tools"]["assemblies"].clear()
	detached["tools"]["loose_parts"].clear()
	detached["tools"]["maintenance"].clear()
	var snapshot: String = world.capture_world_snapshot_json().value
	var commands_before: int = remote.sent.size()
	panel.observe(detached)
	check(world.capture_world_snapshot_json().value == snapshot and remote.sent.size() == commands_before, "detached rendering mutates no canonical records or commands")
	check(not panel._maintenance_targets.text.contains("Observed installed part ID:") and panel._result.text == pending_text, "removed observed target unavailable while exact pending intent survives")
	var unrelated := ProductionDevelopmentCommand.new()
	unrelated.command_id = &"unrelated-repair-receipt"
	remote.command_completed.emit(unrelated, ServiceResult.success())
	check(panel._result.text == pending_text and not panel._pending.is_empty(), "unrelated receipt cannot complete repair")
	apply(request)
	check(last.is_success, "real repair succeeds")
	remote.command_completed.emit(request, last)
	check(panel._result.text.contains("Receipt targets") and panel._result.text.contains(head) and not panel._maintenance_targets.text.contains("healthy"), "receipt preserves targets without synthesizing repaired observation")
	panel.observe(frame())
	check(panel._maintenance_targets.text.contains("healthy") and panel._pending_component.is_empty(), "fresh host frame confirms repaired integrity")
	choose(panel._tool_parts, other)
	panel._update_buttons()
	panel._repair_component()
	request = remote.sent[-1]
	command("repair_tool_component", {"part_id": other, "amount_ppm": 1000000, "expected_tool_revision": frame()["tools"]["state_revision"]})
	before = frame()
	apply(request)
	check(not last.is_success, "real stale repair rejects: " + last.message)
	check(frame()["tools"] == before["tools"] and frame()["production"]["energy_joules"] == before["production"]["energy_joules"], "rejected repair changes no components or paid energy")
	remote.command_completed.emit(request, last)
	check(panel._result.text.contains(last.message) and panel._result.text.contains(other), "rejection retains host reason and exact repair target")
	panel.observe(frame())
	for operation: String in ["equip", "select_hand"]:
		var equip_request := InventoryDevelopmentCommand.new()
		equip_request.command_id = StringName("maintenance-work-" + operation)
		equip_request.operation = "self"
		equip_request.payload = {"operation": operation, "expected_revision": frame()["inventory"]["inventory_revision"], "slot_id": "hand.left", "item_id": "", "source_container_id": "", "destination_container_id": ""}
		if operation == "equip": equip_request.payload.merge({"item_id": "extractor-1", "source_container_id": "storage.backpack-2"}, true)
		apply(equip_request)
		check(last.is_success, "work fixture " + operation + ": " + last.message)
	move(ProductionSimulationSystem.SOURCE_POSITIONS["deposit.iron"])
	panel.observe(frame())
	panel._work_cycles.value = 2
	choose(panel._deposit, "deposit.iron")
	choose(panel._carrier, "resource-canister-1")
	panel._update_buttons()
	check(panel._work_targets.text.contains("Intended source ID: deposit.iron; observed.") and panel._work_targets.text.contains("Intended receiving canister ID: resource-canister-1; observed."), "work selections explicit before action")
	panel._sustained_action("start_tool_extract")
	request = remote.sent[-1]
	check(panel._result.text.contains("Requested cycles: 2") and panel._result.text.contains("Source ID: deposit.iron") and panel._result.text.contains("No repair, output, mount change or work-cycle completion confirmed"), "start intent shows exact targets without completion")
	apply(request)
	check(last.is_success, "real panel sustained extraction starts: " + last.message)
	remote.command_completed.emit(request, last)
	panel.observe(frame())
	check(panel._work_targets.text.contains("Observed reserved tool_id: extractor-1") and panel._work_status.text.contains("0 completed, 2 reserved"), "reservation observed separately from completed work")
	choose(panel._deposit, "deposit.ice")
	panel._update_buttons()
	check(panel._work_targets.text.contains("Intended source ID: deposit.ice") and panel._work_targets.text.contains("Observed reserved deposit_id: deposit.iron"), "changed source selection does not retarget reservation")
	for _tick in range(60): step()
	panel.observe(frame())
	check(panel._work_status.text.contains("1 completed, 1 reserved"), "completed work comes from real host cycle")
	panel._sustained_action("cancel_tool_extract")
	request = remote.sent[-1]
	check(not request.payload.has("deposit_id") and panel._result.text.contains("Action: cancel_tool_extract") and panel._result.text.contains("Observed reserved source ID at submit: deposit.iron"), "cancel preserves existing reservation command contract")
	apply(request)
	check(last.is_success, "real reservation cancel succeeds")
	remote.command_completed.emit(request, last)
	move([0, 0, 0])
	panel.observe(frame())
	choose(panel._tool_parts, head)
	panel._repair_component()
	var sent_count: int = remote.sent.size()
	remote.connection_closed.emit("Disconnected")
	check(panel._maintenance_targets.text.contains("unavailable") and panel._work_targets.text.contains("unavailable") and panel._pending_component.is_empty(), "disconnect removes maintenance and work claims")
	remote.command_completed.emit(remote.sent[-1], ServiceResult.success())
	check(panel._result.text.contains("outcome is unknown") and remote.sent.size() == sent_count, "late receipt after disconnect has no success claim or retry")
	panel.free()
	remote.free()
	world.free()
	if failures == 0: print("Maintenance target feedback: actual repair success, stale rejection, detached render, exact receipts and disconnect passed.")
	quit(0 if failures == 0 else 1)

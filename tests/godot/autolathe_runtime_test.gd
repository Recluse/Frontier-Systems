extends "res://tests/godot/machinery_runtime_test.gd"


func run() -> void:
	world = WorldRuntime.new()
	world.resource_carriers_enabled = true
	root.add_child(world)
	world.command_completed.connect(func(_command: SimulationCommand, result: ServiceResult) -> void: last = result)
	check(world.start_simulation().is_success, "world starts")
	runner = world.get_node("SimulationRunner")
	runner.set_physics_process(false)
	production = world.get_simulation_system(ProductionSimulationSystem.SYSTEM_ID)
	inventory = world.get_simulation_system(InventorySimulationSystem.SYSTEM_ID)
	context = AuthenticatedCommandContext.for_local_development(&"local-inventory-actor", world.world_id, world.region_id)
	for batch in range(8):
		move([-3000, 0, -1000])
		command("extract", {"deposit_id": "deposit.iron", "carrier_id": "resource-canister-1", "amount_milligrams": 1000000})
		move([0, 0, 0])
		command("unload_cargo", {"carrier_id": "resource-canister-1", "material": "ore.iron", "amount_milligrams": 1000000})
		command("process", {"recipe_id": "refine.iron"})
		step(120)
	var generator: String = assemble("solar", [-1100, 0, -1000])
	var lathe: String = assemble("autolathe", [900, 0, -1000])
	var cable: String = craft("cable")
	command("machine_wire", {"machine_id": generator, "other_id": lathe, "item_id": cable})
	command("process", {"recipe_id": "craft.plate"})
	step(120)
	command("materialize_plate", {})
	var plate: String = production.observation(context).value["components"][0]
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": "resource-canister-1"}, false)
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": plate})
	check(MachineryWorkshop.item(inventory.capture_snapshot().value["owner"], plate).is_empty(), "feeding destroys only the physical plate, retaining its matter")
	check(production.payload_mass(lathe) == 1500000, "hopper iron contributes to the frame's carried mass")
	step(60)
	var before: Dictionary = production.capture_snapshot().value
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "controller"})
	var output: String = newest(before["machinery"]["parts"])
	check(production.capture_snapshot().value["cargo"][lathe]["iron"] == 900000, "fabrication debits exact iron bill")
	check(not production.capture_snapshot().value["machinery"]["mounts"].has(output), "output is physical and unfitted")
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "equipment.canister"}, false)
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "untrusted.design"}, false)
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": output}, false)
	command("machine_unfit", {"machine_id": lathe, "item_id": output, "socket_id": ""})
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": output})
	check(production.capture_snapshot().value["cargo"][lathe]["iron"] == 1000000, "scrapped output recovers its conserved bill")
	command("process", {"recipe_id": "craft.plate"})
	step(120)
	command("materialize_plate", {})
	plate = production.observation(context).value["components"][0]
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": plate})
	var spare: String = craft("power")
	command("machine_autolathe_feed", {"machine_id": lathe, "item_id": spare}, false)
	check(not MachineryWorkshop.item(inventory.capture_snapshot().value["owner"], spare).is_empty(), "full hopper rejects without destroying the feed item")
	command("machine_autolathe_eject", {"machine_id": lathe, "item_id": "resource-canister-1", "amount_milligrams": 400000})
	check(production.capture_snapshot().value["cargo"]["resource-canister-1"]["iron"] == 400000, "leftover solids return to an owned canister")
	command("machine_autolathe_eject", {"machine_id": lathe, "item_id": "resource-canister-1", "amount_milligrams": 0}, false)
	command("machine_autolathe_eject", {"machine_id": lathe, "item_id": "resource-canister-1", "amount_milligrams": 2000000}, false)
	var snapshot: ServiceResult = world.capture_world_snapshot_json()
	check(snapshot.is_success, "hopper, inventory and world conserve matter")
	var restored := WorldRuntime.new()
	restored.resource_carriers_enabled = true
	root.add_child(restored)
	check(restored.restore_world_snapshot_json(snapshot.value).is_success, "solid hopper survives restart")
	var restored_production: ProductionSimulationSystem = restored.get_simulation_system(ProductionSimulationSystem.SYSTEM_ID)
	check(restored_production.payload_mass(lathe) == 2100000, "restored payload mass includes stored iron")
	restored.free()
	var forged: Dictionary = JSON.parse_string(snapshot.value)
	forged["systems"]["production"]["cargo"][lathe]["iron"] -= 1
	forged["systems"]["production"]["cargo"][lathe]["water"] = 1
	restored = WorldRuntime.new()
	restored.resource_carriers_enabled = true
	root.add_child(restored)
	check(not restored.restore_world_snapshot_json(JSON.stringify(forged)).is_success, "non-solid forged hopper contents reject")
	restored.free()
	command("machine_enable", {"machine_id": lathe, "enabled": false})
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "power"}, false)
	command("machine_enable", {"machine_id": lathe, "enabled": true})
	var head: String = MachineryWorkshop.modules(production.capture_snapshot().value["machinery"], inventory.capture_snapshot().value["owner"], lathe)["autolathe"][0]
	command("machine_unfit", {"machine_id": lathe, "item_id": head, "socket_id": ""})
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "power"}, false)
	check(production.capture_snapshot().value["cargo"][lathe]["iron"] == 1600000, "disabled and missing heads preserve hopper stock")
	fit(lathe, head)
	fit(lathe, craft("expander"))
	var old_equipment: Dictionary = production.capture_snapshot().value["structures"]
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "equipment.extractor"})
	var tool: String = ""
	for id in production.capture_snapshot().value["structures"]:
		if not old_equipment.has(id): tool = id
	check(not tool.is_empty(), "expanded autolathe produces equipment from the trusted blueprint")
	var tools: ToolSimulationSystem = world.get_simulation_system(ToolSimulationSystem.SYSTEM_ID)
	check(tools.capability(tool, "tool.extractor").value, "fabricated equipment has independent working tool components")
	move([5000, 0, 0])
	command("machine_autolathe_make", {"machine_id": lathe, "kind": "power"}, false)
	move([0, 0, 0])
	var panel := MachineryPanel.new()
	root.add_child(panel)
	panel.configure(world)
	panel.observe({"production": production.observation(context).value, "inventory": inventory.own_inventory_observation(context).value, "position": [0, 0, 0]})
	check(panel._status.text.contains("iron 0.100 kg"), "construction UI shows authoritative hopper stock")
	panel.free()
	var preview := MachineryPreview.new()
	root.add_child(preview)
	preview.observe(production.observation(context).value)
	check(preview._labels[lathe]["label"].text.contains("AUTOLATHE") and preview._labels[lathe]["label"].text.contains("HOPPER 0.100 kg"), "static presentation shows the installed autolathe and live hopper stock")
	preview.free()
	check(production.profiling_counters()["hopper_milligrams"] == 100000, "hopper profiling is available without changing behavior")
	command("machine_unwire", {"machine_id": lathe, "item_id": cable})
	command("machine_pack", {"machine_id": lathe})
	command("machine_recycle", {"item_id": lathe}, false)
	check(world.capture_world_snapshot_json().is_success, "packing retains hopper stock without material loss")
	# Legacy fingerprint compatibility is explicit and refuses new kinds under it.
	var legacy: Dictionary = MachineryWorkshop.initial()
	legacy["catalog_fingerprint"] = JSON.stringify(MachineryWorkshop.LEGACY_KINDS, "", true).sha256_text()
	check(MachineryWorkshop.validate(legacy), "original workshop fingerprint remains readable")
	legacy["parts"]["forged-head"] = {"kind": "autolathe"}
	check(not MachineryWorkshop.validate(legacy), "legacy catalog cannot claim a newly introduced module")
	print("Autolathe integration: %d failures" % failures)
	finish()

# Optional host event telemetry; disabled while URL is empty.
FRONTIER_EVENT_URL=
FRONTIER_EVENT_TOKEN=
# Local test receiver scope (match the game's authoritative world).
FRONTIER_EVENT_WORLD=development-world
FRONTIER_EVENT_REGION=local-habitat

# Optional native first-playable host backup history. Both empty means disabled.
# Set both canonical decimal limits: entries 1-8; retained bytes 1-67108864.
FRONTIER_BACKUP_ENTRIES=
FRONTIER_BACKUP_BYTES=
{
  "name": "frontier-systems/control-plane",
  "description": "Asynchronous PHP control plane for Frontier Systems game services.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "frontier-systems/php-foundation": "^0.1@dev",
    "react/cache": "^1.0",
    "react/event-loop": "^1.2",
    "react/http": "^1.9",
    "react/promise": "^3.0",
    "react/socket": "^1.9"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpdocumentor/shim": "^3.10",
    "phpunit/phpunit": "^11.5",
    "phpacker/phpacker": "^0.6.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/php-foundation",
      "options": {
        "symlink": false,
        "versions": {
          "frontier-systems/php-foundation": "0.1.x-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Frontier\\ControlPlane\\": "src/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "unit": "phpunit --testdox",
    "docs": [
      "phpdoc run --directory=src --target=../../docs/generated/php-api/control-plane",
      "phpdoc run --directory=../../packages/world-contracts/src --target=../../docs/generated/php-api/world-contracts",
      "phpdoc run --directory=../../packages/profiling/src --target=../../docs/generated/php-api/profiling",
      "phpdoc run --directory=../../packages/profiling-http/src --target=../../docs/generated/php-api/profiling-http",
      "phpdoc run --directory=../../packages/twitch/src --target=../../docs/generated/php-api/twitch"
    ],
    "phar": "@php -d phar.readonly=0 build/build-phar.php",
    "phpacker": [
      "@phar",
      "phpacker build all --src=bin/build/control-plane.phar --dest=bin/build/control-plane"
    ]
  },
  "scripts-descriptions": {
    "cs": "Format the PHP control-plane source with PHP-CS-Fixer.",
    "cs-check": "Check PHP source formatting without changing files.",
    "unit": "Run the PHP control-plane PHPUnit suite.",
    "docs": "Generate PHPDocumentor API documentation for the control plane, world contracts and profiling package.",
    "phar": "Build a PHAR with the application and production dependencies.",
    "phpacker": "Build standalone control-plane binaries for PHPacker-supported platforms."
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "phpdocumentor/shim": true
    }
  }
}

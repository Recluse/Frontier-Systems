# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Showcase media is stored through Git LFS; gallery metadata remains plain text.
docs/gallery/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.webp filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.gif filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/gallery/**/*.webm filter=lfs diff=lfs merge=lfs -text

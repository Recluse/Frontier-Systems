{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-material-state:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "cell_id", "state_revision", "material_id", "material_revision", "mass_milligrams"],
  "properties": {
    "schema_version": { "const": 1 },
    "cell_id": { "$ref": "#/$defs/id" }, "material_id": { "$ref": "#/$defs/id" },
    "state_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "material_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "mass_milligrams": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } }
}

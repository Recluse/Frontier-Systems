{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:shared-inventory-transfer-intent:v1",
  "title": "Internal shared inventory transfer intent v1",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "action", "actor_body_id", "target_body_id", "item_id", "source_container_id", "destination_container_id", "slot_id", "expected_revision"],
  "properties": {
    "request_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["take", "insert", "equip", "unequip"]},
    "actor_body_id": {"$ref": "#/$defs/id"}, "target_body_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/id"},
    "source_container_id": {"$ref": "#/$defs/id"}, "destination_container_id": {"$ref": "#/$defs/id"},
    "slot_id": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]}, "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}},
  "allOf": [{"if": {"properties": {"action": {"enum": ["equip", "unequip"]}}}, "then": {"properties": {"slot_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"slot_id": {"const": ""}}}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-return-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "principal_id",
    "request_number",
    "item_id",
    "transfer_id",
    "expected_inventory_revision",
    "owner_sequence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "request_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "item_id": {
      "type": "string",
      "pattern": "^terrain-item-[1-9][0-9]*$",
      "maxLength": 128
    },
    "transfer_id": {
      "type": "string",
      "pattern": "^terrain-transfer-[1-9][0-9]*$",
      "maxLength": 128
    },
    "expected_inventory_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740989
    },
    "owner_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-material-owner:v1",
  "description": "Complete bounded terrain checkpoint. Trusted code additionally validates catalog references, per-origin conservation, owner/cell revision totals, generated IDs, exact receipt plans, and rewind/replay correspondence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "last_sequence", "origins", "cells", "transfers", "receipts"],
  "properties": {
    "schema_version": { "const": 1 },
    "owner_id": { "$ref": "#/$defs/id" },
    "last_sequence": { "$ref": "#/$defs/nonnegativeInteger" },
    "origins": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/origin" }
    },
    "cells": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/cell" }
    },
    "transfers": {
      "type": "object", "maxProperties": 256,
      "propertyNames": { "type": "string", "pattern": "^terrain-transfer-[1-9][0-9]{0,15}$" },
      "additionalProperties": { "$ref": "#/$defs/transfer" }
    },
    "receipts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/receipt" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "parcels": {
      "type": "object", "maxProperties": 16,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/positiveInteger" }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "material_revision", "generation_revision", "initial_mass_milligrams"],
      "properties": {
        "material_id": { "$ref": "#/$defs/id" },
        "material_revision": { "$ref": "#/$defs/positiveInteger" },
        "generation_revision": { "$ref": "#/$defs/positiveInteger" },
        "initial_mass_milligrams": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "capacity_milligrams", "parcels"],
      "properties": {
        "state": { "$ref": "urn:frontier-systems:schema:terrain-material-state:v1" },
        "capacity_milligrams": { "$ref": "#/$defs/nonnegativeInteger" },
        "parcels": { "$ref": "#/$defs/parcels" }
      }
    },
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "material_revision", "mass_milligrams", "parcels"],
      "properties": {
        "material_id": { "$ref": "#/$defs/id" },
        "material_revision": { "$ref": "#/$defs/positiveInteger" },
        "mass_milligrams": { "$ref": "#/$defs/positiveInteger" },
        "parcels": { "$ref": "#/$defs/parcels" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "transfer_id", "terrain_plan", "parcels"],
      "properties": {
        "command": { "$ref": "urn:frontier-systems:schema:terrain-owner-intent:v1" },
        "transfer_id": { "type": "string", "pattern": "^terrain-transfer-[1-9][0-9]{0,15}$" },
        "terrain_plan": { "$ref": "urn:frontier-systems:schema:terrain-material-transfer-plan:v1" },
        "parcels": { "$ref": "#/$defs/parcels" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:tool-observation:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_revision",
    "assemblies",
    "loose_parts",
    "part_blueprints"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "assemblies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assembly_id",
          "functions",
          "actions",
          "parts",
          "slots"
        ],
        "properties": {
          "assembly_id": {
            "$ref": "#/$defs/id"
          },
          "functions": {
            "$ref": "#/$defs/ids"
          },
          "actions": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "$ref": "#/$defs/id"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "available",
                "missing_functions"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "missing_functions": {
                  "$ref": "#/$defs/ids"
                }
              }
            }
          },
          "parts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "part_id",
                "definition_id",
                "material_id",
                "integrity_ppm",
                "wear_remainder",
                "name",
                "material_name"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "part_id": {
                  "$ref": "#/$defs/id"
                },
                "definition_id": {
                  "$ref": "#/$defs/id"
                },
                "material_id": {
                  "$ref": "#/$defs/id"
                },
                "integrity_ppm": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "wear_remainder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "material_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "maxLength": 128,
              "type": "string"
            },
            "maxProperties": 16,
            "propertyNames": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "loose_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "part_id",
          "definition_id",
          "material_id",
          "integrity_ppm",
          "wear_remainder",
          "name",
          "material_name"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "part_id": {
            "$ref": "#/$defs/id"
          },
          "definition_id": {
            "$ref": "#/$defs/id"
          },
          "material_id": {
            "$ref": "#/$defs/id"
          },
          "integrity_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "wear_remainder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "material_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "maxItems": 128
    },
    "part_blueprints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fabrication_energy_joules": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 1
          },
          "material_id": {
            "$ref": "#/$defs/id"
          },
          "definition_id": {
            "$ref": "#/$defs/id"
          },
          "salvage_energy_joules": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "materials": {
            "type": "object",
            "maxProperties": 32,
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "maximum": 100000000,
              "minimum": 1
            },
            "propertyNames": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "definition_id",
          "material_id",
          "fabrication_energy_joules",
          "salvage_energy_joules",
          "name",
          "materials"
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "description": "Scoped component view, including slots, owned loose parts and trusted blueprint quotes. Client also checks unique global part ownership and exact mounted/observed correspondence. Slots use an empty string for an empty mount."
}

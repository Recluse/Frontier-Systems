{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:production-catalog:v1",
  "title": "Trusted production recipe catalog v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "materials", "dispensable", "deposits", "recipes"],
  "properties": {
    "schema_version": {"const": 1},
    "materials": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "dispensable": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "deposits": {"type": "object", "maxProperties": 16, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["material", "mass_milligrams"],
      "properties": {"material": {"$ref": "#/$defs/id"}, "mass_milligrams": {"type": "integer", "minimum": 1000000, "maximum": 100000000}}
    }},
    "recipes": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["station", "inputs", "outputs", "duration_ticks", "energy_joules"],
      "properties": {
        "station": {"enum": ["drill", "refinery", "chemical", "printer", "recycler", "dispenser", "construction"]},
        "inputs": {"$ref": "#/$defs/ingredients"}, "outputs": {"$ref": "#/$defs/ingredients"},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 36000},
        "energy_joules": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "ingredients": {"type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 100000000}}
  },
  "description": "Runtime enforces known material identities, total mass budgets and equal input/output mass. Changes alter the catalog fingerprint and require explicit snapshot migration."
}

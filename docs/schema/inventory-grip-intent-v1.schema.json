{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-grip-intent:v1",
  "title": "Local inventory grip command operation and payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "payload"],
  "properties": {
    "operation": {"enum": ["grip_join", "grip_release", "grip_resume"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "grip_join"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/join"}}}, "else": {"properties": {"payload": {"$ref": "#/$defs/member"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "join": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "expected_revision", "target_id", "action", "hand_ids"],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "expected_revision": {"$ref": "#/$defs/revision"},
        "target_id": {"enum": ["fixture.salvage-crate", "fixture.ladder"]},
        "action": {"enum": ["grab", "pull_along", "move_world_object"]},
        "hand_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "expected_revision"],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "expected_revision": {"$ref": "#/$defs/revision"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-system-state:v4",
  "title": "Local development inventory and grip simulation state v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_tick",
    "owner",
    "bodies",
    "jobs",
    "world_storage",
    "grips"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "last_tick": {
      "$ref": "#/$defs/counter"
    },
    "owner": {
      "$ref": "urn:frontier-systems:schema:shared-inventory-state:v1"
    },
    "bodies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body_id",
          "principal_id",
          "control_epoch",
          "action_epoch",
          "resisted_tick",
          "position_millimetres"
        ],
        "properties": {
          "body_id": {
            "$ref": "#/$defs/id"
          },
          "principal_id": {
            "$ref": "#/$defs/id"
          },
          "control_epoch": {
            "$ref": "#/$defs/counter"
          },
          "action_epoch": {
            "$ref": "#/$defs/counter"
          },
          "resisted_tick": {
            "type": "integer",
            "minimum": -1,
            "maximum": 9007199254740990
          },
          "position_millimetres": {
            "items": {
              "minimum": -10000000,
              "maximum": 10000000,
              "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3,
            "type": "array"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "principal_id",
          "request"
        ],
        "properties": {
          "job": {
            "$ref": "urn:frontier-systems:schema:body-inventory-interaction-job:v1"
          },
          "principal_id": {
            "$ref": "#/$defs/id"
          },
          "request": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:frontier-systems:schema:shared-inventory-transfer-intent:v1"
              }
            ]
          }
        }
      }
    },
    "world_storage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "container_id": {
            "$ref": "#/$defs/id"
          },
          "accessible": {
            "type": "boolean"
          },
          "position_millimetres": {
            "items": {
              "minimum": -10000000,
              "maximum": 10000000,
              "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3,
            "type": "array"
          }
        },
        "additionalProperties": false,
        "required": [
          "container_id",
          "accessible",
          "position_millimetres"
        ]
      },
      "maxItems": 32
    },
    "grips": {
      "$ref": "urn:frontier-systems:schema:physical-grip-owner:v1"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    }
  }
}

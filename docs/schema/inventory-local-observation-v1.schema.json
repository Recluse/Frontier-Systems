{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-local-observation:v1",
  "title": "Principal-scoped local inventory job observation v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "inventory_revision", "outcomes", "jobs"],
  "properties": {
    "schema_version": {"const": 1}, "inventory_revision": {"$ref": "#/$defs/counter"},
    "outcomes": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "principal_id", "success", "error_code", "view_id"],
      "properties": {
        "job_id": {"$ref": "#/$defs/id"}, "principal_id": {"$ref": "#/$defs/id"}, "success": {"type": "boolean"},
        "error_code": {"$ref": "#/$defs/optionalId"}, "view_id": {"$ref": "#/$defs/optionalId"}
      }
    }},
    "jobs": {"type": "array", "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "action", "state", "progress_ticks", "duration_ticks"],
      "properties": {
        "job_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["search", "take", "insert", "equip", "unequip"]}, "state": {"enum": ["active", "paused"]},
        "progress_ticks": {"type": "integer", "minimum": 0, "maximum": 3600}, "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "optionalId": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  }
}

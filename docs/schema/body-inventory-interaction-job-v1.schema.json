{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:body-inventory-interaction-job:v1",
  "title": "Timed other-body inventory interaction job v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "actor_body_id", "target_body_id", "policy_id", "policy_revision", "action", "target_container_id", "item_id", "slot_id", "last_tick", "progress_ticks", "state", "cancellation_code", "actor_control_epoch", "target_action_epoch", "actor_inventory_revision", "target_inventory_revision"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"$ref": "#/$defs/id"}, "actor_body_id": {"$ref": "#/$defs/id"}, "target_body_id": {"$ref": "#/$defs/id"},
    "policy_id": {"$ref": "#/$defs/id"}, "policy_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "action": {"enum": ["search", "take", "insert", "equip", "unequip"]},
    "target_container_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/optionalId"}, "slot_id": {"$ref": "#/$defs/optionalId"},
    "last_tick": {"$ref": "#/$defs/counter"}, "progress_ticks": {"type": "integer", "minimum": 0, "maximum": 3600},
    "state": {"enum": ["active", "ready", "paused", "cancelled"]}, "cancellation_code": {"$ref": "#/$defs/optionalId"},
    "actor_control_epoch": {"$ref": "#/$defs/counter"}, "target_action_epoch": {"$ref": "#/$defs/counter"},
    "actor_inventory_revision": {"$ref": "#/$defs/counter"}, "target_inventory_revision": {"$ref": "#/$defs/counter"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "optionalId": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "search"}}}, "then": {"properties": {"item_id": {"const": ""}}}, "else": {"properties": {"item_id": {"$ref": "#/$defs/id"}}}},
    {"if": {"properties": {"action": {"enum": ["equip", "unequip"]}}}, "then": {"properties": {"slot_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"slot_id": {"const": ""}}}},
    {"if": {"properties": {"state": {"const": "cancelled"}}}, "then": {"properties": {"cancellation_code": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"cancellation_code": {"const": ""}}}}
  ]
}

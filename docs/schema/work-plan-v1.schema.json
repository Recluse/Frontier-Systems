{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:work-plan:v1",
  "title": "Frontier Systems Work Plan v1",
  "description": "Canonical player-owned plan draft; approval and work-order creation are separate server transactions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "world_id",
    "author_principal_id",
    "revision_author_principal_id",
    "revision",
    "title",
    "objective",
    "status",
    "visibility",
    "assumptions",
    "tasks",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "world_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "colony_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "author_principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision_author_principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "rationale": { "type": "string", "maxLength": 8000 },
    "status": {
      "enum": ["draft", "review", "approved", "in_progress", "completed", "failed", "archived"]
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["private", "named_principals", "crew_group", "colony_board"]
        },
        "principal_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "group_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "kind", "description", "dependencies", "preconditions"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": {
            "enum": ["inspect", "repair", "fetch_material", "build_blueprint", "operate_device", "research", "other"]
          },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "target_entity_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "preconditions": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "required_roles": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required_tool_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "blueprint_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "estimated_resources": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["material_id", "quantity", "unit"],
              "properties": {
                "material_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "quantity": { "type": "number", "minimum": 0 },
                "unit": { "type": "string", "minLength": 1, "maxLength": 32 }
              }
            }
          },
          "hazards": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "generated_work_order_id": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "linked_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "source_context_revision_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "parent_revision": { "type": "integer", "minimum": 1 },
    "change_summary": { "type": "string", "maxLength": 500 }
  }
}

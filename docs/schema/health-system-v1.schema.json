{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:health-system:v1",
  "title": "Bounded consciousness scheduling system v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "timebase_hz", "last_tick", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "timebase_hz": {"enum": [60, 72, 90]},
    "last_tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740984},
    "entries": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["owner", "source_revision", "causes", "next_assessment_tick"],
        "properties": {
          "owner": {"$ref": "consciousness-owner-v1.schema.json"},
          "source_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
          "causes": {"$ref": "consciousness-causes-v1.schema.json"},
          "next_assessment_tick": {"type": "integer", "minimum": 1, "maximum": 9007199254740990}
        }
      }
    }
  },
  "description": "Code checks current timebase, exact snapshot tick, unique body IDs, due bounds, owner receipt consistency and inventory body references. Source causes are trusted physiological fixtures, not medication quantities."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:tool-observation:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "state_revision", "assemblies"],
  "properties": {
    "schema_version": {"const": 1},
    "state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740000},
    "assemblies": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["assembly_id", "functions", "actions", "parts"],
      "properties": {
        "assembly_id": {"$ref": "#/$defs/id"},
        "functions": {"$ref": "#/$defs/ids"},
        "actions": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["available", "missing_functions"],
          "properties": {"available": {"type": "boolean"}, "missing_functions": {"$ref": "#/$defs/ids"}}
        }},
        "parts": {"type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "part_id", "definition_id", "material_id", "integrity_ppm", "wear_remainder", "name", "material_name"],
          "properties": {
            "schema_version": {"const": 1},
            "part_id": {"$ref": "#/$defs/id"}, "definition_id": {"$ref": "#/$defs/id"}, "material_id": {"$ref": "#/$defs/id"},
            "integrity_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "wear_remainder": {"type": "integer", "minimum": 0, "maximum": 999},
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "material_name": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "description": "Only tools in the authenticated player's inventory, including nested storage. No detached parts. Client validation additionally rejects duplicate assemblies/parts, more than 512 total parts and inconsistent availability/missing functions."
}

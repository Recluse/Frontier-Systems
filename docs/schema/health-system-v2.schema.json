{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:health-system:v2",
  "title": "Consciousness scheduling with localized injuries v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "timebase_hz", "last_tick", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "timebase_hz": {"enum": [60, 72, 90]},
    "last_tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740984},
    "entries": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["owner", "source_revision", "causes", "injuries", "next_assessment_tick"],
        "properties": {
          "owner": {"$ref": "consciousness-owner-v1.schema.json"},
          "source_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
          "causes": {"$ref": "consciousness-causes-v1.schema.json"},
          "injuries": {"$ref": "body-injury-state-v1.schema.json"},
          "next_assessment_tick": {"type": "integer", "minimum": 1, "maximum": 9007199254740990}
        }
      }
    }
  },
  "description": "Code checks body/tick identity, same timebase, owner/frontier consistency and at most sixteen combined source plus anatomy causes. Injury-owned cause IDs cannot appear in external source observations."
}

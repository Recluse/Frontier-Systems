{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-world-observation:v1",
  "title": "Reachable world storage observation v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "inventory_revision", "containers"],
  "properties": {
    "schema_version": {"const": 1}, "inventory_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "containers": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["container_id", "distance_millimetres", "items"],
      "properties": {
        "container_id": {"$ref": "#/$defs/id"}, "distance_millimetres": {"type": "integer", "minimum": 0, "maximum": 1500},
        "items": {"type": "array", "maxItems": 512, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["item_id", "definition_id", "definition_revision", "condition_permille", "container_id"],
          "properties": {
            "item_id": {"$ref": "#/$defs/id"}, "definition_id": {"$ref": "#/$defs/id"}, "container_id": {"$ref": "#/$defs/id"},
            "definition_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990}, "condition_permille": {"type": "integer", "minimum": 0, "maximum": 1000}
          }
        }}
      }
    }}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}}
}

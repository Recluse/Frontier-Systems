{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-materialize-command:v1",
  "title": "Server-bound whole escrow materialization intent",
  "type": "object",
  "required": [
    "schema_version",
    "request_number",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "transfer_id",
        "expected_inventory_revision"
      ],
      "properties": {
        "transfer_id": {
          "type": "string",
          "pattern": "^terrain-transfer-[1-9][0-9]*$",
          "maxLength": 128
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740989
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

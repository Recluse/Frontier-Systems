{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:shared-inventory-self-intent:v1",
  "title": "Internal self inventory intent v1",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "body_id", "operation", "item_id", "source_container_id", "destination_container_id", "slot_id", "expected_revision"],
  "properties": {
    "request_id": {"$ref": "#/$defs/id"}, "body_id": {"$ref": "#/$defs/id"},
    "operation": {"enum": ["switch_hand", "select_hand", "equip", "unequip", "move"]},
    "item_id": {"$ref": "#/$defs/optionalId"}, "source_container_id": {"$ref": "#/$defs/optionalId"},
    "destination_container_id": {"$ref": "#/$defs/optionalId"}, "slot_id": {"$ref": "#/$defs/optionalId"},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "optionalId": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"enum": ["equip", "move"]}}}, "then": {"properties": {"item_id": {"$ref": "#/$defs/id"}, "source_container_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"item_id": {"const": ""}, "source_container_id": {"const": ""}}}},
    {"if": {"properties": {"operation": {"enum": ["unequip", "move"]}}}, "then": {"properties": {"destination_container_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"destination_container_id": {"const": ""}}}},
    {"if": {"properties": {"operation": {"enum": ["select_hand", "equip", "unequip"]}}}, "then": {"properties": {"slot_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"slot_id": {"const": ""}}}}
  ]
}

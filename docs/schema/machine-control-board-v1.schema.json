{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:machine-control-board:v1",
  "title": "Replaceable machine control board definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "revision", "mount_interface_id", "slots"],
  "properties": {
    "schema_version": { "const": 1 },
    "definition_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "mount_interface_id": { "$ref": "#/$defs/id" },
    "slots": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "urn:frontier-systems:schema:machine-module-slot:v1" }
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } }
}

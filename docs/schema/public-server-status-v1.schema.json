{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:public-server-status:v1",
  "title": "Explicitly public server status publication v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "world_id", "region_id", "tick_number", "public_name", "online", "players_online", "player_capacity", "observed_at_unix"],
  "properties": {
    "schema_version": {"const": 1},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "region_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tick_number": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "public_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "online": {"type": "boolean"},
    "players_online": {"type": "integer", "minimum": 0, "maximum": 65536},
    "player_capacity": {"type": "integer", "minimum": 0, "maximum": 65536},
    "observed_at_unix": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  },
  "description": "Only an authenticated host may publish. Code enforces 4096 encoded bytes, scope matching, counts<=capacity, offline count zero, UTF-8/control rules and freshness/frontier ordering. Scope IDs are max 128 bytes in PHP. World/region/tick fields are removed from viewer projections."
}

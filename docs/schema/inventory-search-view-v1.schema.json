{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-search-view:v1",
  "title": "Scoped direct-container search observation v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "view_id", "actor_body_id", "target_body_id", "container_id", "issued_tick", "expires_tick", "items"],
  "properties": {
    "schema_version": {"const": 1}, "view_id": {"$ref": "#/$defs/id"},
    "actor_body_id": {"$ref": "#/$defs/id"}, "target_body_id": {"$ref": "#/$defs/id"}, "container_id": {"$ref": "#/$defs/id"},
    "issued_tick": {"$ref": "#/$defs/tick"}, "expires_tick": {"$ref": "#/$defs/tick"},
    "items": {"type": "array", "maxItems": 512, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "definition_id", "definition_revision", "condition_permille", "has_storage"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "definition_id": {"$ref": "#/$defs/id"},
        "definition_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
        "condition_permille": {"type": "integer", "minimum": 0, "maximum": 1000}, "has_storage": {"type": "boolean"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  }
}

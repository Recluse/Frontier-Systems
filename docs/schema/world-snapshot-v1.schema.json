{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:world-snapshot:v1",
  "title": "Frontier Systems world snapshot",
  "description": "Versioned JSON data exchanged between the Godot world runtime and persistence services.",
  "type": "object",
  "required": ["schema_version", "world_id", "region_id", "tick_number", "systems"],
  "properties": {
    "schema_version": { "const": 1 },
    "world_id": { "type": "string", "minLength": 1 },
    "region_id": { "type": "string", "minLength": 1 },
    "tick_number": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "systems": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "pressure": { "$ref": "#/$defs/pressureSystem" },
        "health": { "$ref": "urn:frontier-systems:schema:health-system:v1" },
        "access_control": { "$ref": "urn:frontier-systems:schema:access-control-system:v1" },
        "machine_control": { "oneOf": [
          { "$ref": "urn:frontier-systems:schema:machine-control-system:v1" },
          { "$ref": "urn:frontier-systems:schema:machine-control-system:v2" },
          { "$ref": "urn:frontier-systems:schema:machine-control-system:v3" }
        ] }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["schema_version"],
        "properties": {
          "schema_version": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pressureVolume": {
      "type": "object",
      "required": ["schema_version", "volume_id", "volume_m3", "temperature_kelvin", "gas_moles"],
      "properties": {
        "schema_version": { "const": 1 },
        "volume_id": { "type": "string", "minLength": 1 },
        "volume_m3": { "type": "number", "exclusiveMinimum": 0 },
        "temperature_kelvin": { "type": "number", "exclusiveMinimum": 0 },
        "gas_moles": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "airlock": {
      "type": "object",
      "required": [
        "schema_version",
        "airlock_id",
        "habitat_volume_id",
        "chamber_volume_id",
        "exterior_volume_id",
        "inner_door_open",
        "outer_door_open",
        "equalization_valve_open",
        "vent_valve_open",
        "equalization_conductance_mol_per_second_kpa",
        "vent_conductance_mol_per_second_kpa"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "airlock_id": { "type": "string", "minLength": 1 },
        "habitat_volume_id": { "type": "string", "minLength": 1 },
        "chamber_volume_id": { "type": "string", "minLength": 1 },
        "exterior_volume_id": { "type": "string", "minLength": 1 },
        "inner_door_open": { "type": "boolean" },
        "outer_door_open": { "type": "boolean" },
        "equalization_valve_open": { "type": "boolean" },
        "vent_valve_open": { "type": "boolean" },
        "equalization_conductance_mol_per_second_kpa": { "type": "number", "minimum": 0 },
        "vent_conductance_mol_per_second_kpa": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pressureSensor": {
      "type": "object",
      "required": ["schema_version", "sensor_id", "volume_id", "pressure_kpa_absolute", "last_sampled_tick", "sample_count"],
      "properties": {
        "schema_version": { "const": 1 },
        "sensor_id": { "type": "string", "minLength": 1 },
        "volume_id": { "type": "string", "minLength": 1 },
        "pressure_kpa_absolute": { "type": "number", "minimum": 0 },
        "last_sampled_tick": { "type": "integer", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pressureSystem": {
      "type": "object",
      "required": ["schema_version", "volumes", "airlocks", "sensors", "total_transferred_moles"],
      "properties": {
        "schema_version": { "const": 1 },
        "volumes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pressureVolume" } },
        "airlocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/airlock" } },
        "sensors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pressureSensor" } },
        "total_transferred_moles": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}

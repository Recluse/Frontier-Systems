{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:tick-profile-capture:v1",
  "title": "Detached world profiling capture for asynchronous export",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "world_id", "region_id", "capture_tick_number", "history", "report"],
  "properties": {
    "schema_version": { "const": 1 },
    "world_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "region_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "capture_tick_number": { "type": "integer", "minimum": 0 },
    "history": { "$ref": "urn:frontier-systems:schema:tick-profile-history:v1" },
    "report": { "$ref": "urn:frontier-systems:schema:tick-profile-report:v1" }
  }
}

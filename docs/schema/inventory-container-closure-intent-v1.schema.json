{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-container-closure-intent:v1",
  "title": "Authenticated open_container or close_container payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["container_id", "expected_revision"],
  "properties": {
    "container_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  }
}

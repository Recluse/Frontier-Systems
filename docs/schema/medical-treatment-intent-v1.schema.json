{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:medical-treatment-intent:v1",
  "title": "Localized treatment intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target_body_id", "supply_id", "part_id", "expected_injury_revision", "expected_supply_revision"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/id"},
    "target_body_id": {"$ref": "#/$defs/id"},
    "supply_id": {"$ref": "#/$defs/id"},
    "part_id": {"enum": ["head", "torso", "arm.left", "arm.right", "leg.left", "leg.right"]},
    "expected_injury_revision": {"$ref": "#/$defs/revision"},
    "expected_supply_revision": {"$ref": "#/$defs/revision"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  },
  "description": "Domain intent only; currently no player-facing runtime endpoint. Actor identity and physical capabilities come from server observations."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:medical-supply-state:v1",
  "title": "Finite medical supply state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "supply_id", "definition_id", "state_revision", "last_changed_tick", "charges_remaining"],
  "properties": {
    "schema_version": {"const": 1},
    "supply_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "definition_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "last_changed_tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "charges_remaining": {"type": "integer", "minimum": 0, "maximum": 1000}
  },
  "description": "Stable supply ID refers to one physical inventory item. Charges do not own location or permissions. Code validates revision timing and current charge budget."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:push-off-motion-intent:v1",
  "title": "Paired motion owner push-off intent v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "actor_body_id", "target_body_id", "expected_owner_revision", "expected_actor_revision", "expected_target_revision", "impulse_micro_ns"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/id"},
    "actor_body_id": {"$ref": "#/$defs/id"},
    "target_body_id": {"$ref": "#/$defs/id"},
    "expected_owner_revision": {"$ref": "#/$defs/revision"},
    "expected_actor_revision": {"$ref": "#/$defs/revision"},
    "expected_target_revision": {"$ref": "#/$defs/revision"},
    "impulse_micro_ns": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": -1000000000, "maximum": 1000000000}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:physical-grip-owner:v1",
  "title": "Physical grip owner v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_id", "state_revision", "sessions", "receipts"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "#/$defs/id"},
    "state_revision": {"$ref": "#/$defs/revision"},
    "sessions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/session"}},
    "receipts": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "target_id", "action", "paused", "participants"],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "action": {"enum": ["grab", "pull_along", "move_world_object"]},
        "paused": {"type": "boolean"},
        "participants": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/participant"}}
      },
      "allOf": [{"if": {"properties": {"action": {"enum": ["grab", "pull_along"]}}}, "then": {"properties": {"participants": {"maxItems": 1}}}}]
    },
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["body_id", "hand_ids"],
      "properties": {
        "body_id": {"$ref": "#/$defs/id"},
        "hand_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "fingerprint", "result_revision"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990}
      }
    }
  }
}

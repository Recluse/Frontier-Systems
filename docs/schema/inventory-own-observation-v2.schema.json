{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-own-observation:v2",
  "title": "Local body inventory and equipment observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "body_id",
    "active_hand_slot_id",
    "equipped",
    "items",
    "mass_milligrams",
    "container_ids",
    "body_container_id",
    "hand_slot_ids",
    "slot_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "body_id": {
      "$ref": "#/$defs/id"
    },
    "active_hand_slot_id": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "mass_milligrams": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "equipped": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "item_id"
        ],
        "properties": {
          "slot_id": {
            "$ref": "#/$defs/id"
          },
          "item_id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "definition_id",
          "definition_revision",
          "condition_permille",
          "container_id"
        ],
        "properties": {
          "item_id": {
            "$ref": "#/$defs/id"
          },
          "definition_id": {
            "$ref": "#/$defs/id"
          },
          "container_id": {
            "$ref": "#/$defs/id"
          },
          "definition_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "condition_permille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    },
    "body_container_id": {
      "$ref": "#/$defs/id"
    },
    "container_ids": {
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "maxItems": 256
    },
    "hand_slot_ids": {
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "maxItems": 16
    },
    "slot_ids": {
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "maxItems": 64
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    }
  }
}

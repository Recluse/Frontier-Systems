{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:machine-control-circuit:v1",
  "title": "Versioned machine circuit state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "board_definition_id", "board_revision", "host_capabilities", "powered", "tick_number", "sequence", "modules", "wires", "pending"],
  "properties": {
    "schema_version": { "const": 1 },
    "board_definition_id": { "$ref": "#/$defs/id" },
    "board_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "host_capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "powered": { "type": "boolean" },
    "tick_number": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "modules": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:frontier-systems:schema:machine-module-instance:v1" } },
    "wires": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/wire" } },
    "pending": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/pulse" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "wire": {
      "type": "object", "additionalProperties": false,
      "required": ["wire_id", "first_module", "first_port", "second_module", "second_port"],
      "properties": {
        "wire_id": { "$ref": "#/$defs/id" },
        "first_module": { "$ref": "#/$defs/id" }, "first_port": { "$ref": "#/$defs/id" },
        "second_module": { "$ref": "#/$defs/id" }, "second_port": { "$ref": "#/$defs/id" }
      }
    },
    "pulse": {
      "type": "object", "additionalProperties": false,
      "required": ["wire_id", "source_module", "source_port", "target_module", "target_port", "due_tick", "sequence"],
      "properties": {
        "wire_id": { "$ref": "#/$defs/id" },
        "source_module": { "$ref": "#/$defs/id" }, "source_port": { "$ref": "#/$defs/id" },
        "target_module": { "$ref": "#/$defs/id" }, "target_port": { "$ref": "#/$defs/id" },
        "due_tick": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 }
      }
    }
  }
}

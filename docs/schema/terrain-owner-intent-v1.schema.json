{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-owner-intent:v1",
  "description": "Owner-local tick intent. Request ID must equal terrain-request-<sequence>; trusted code enforces arithmetic and identity correspondence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "request_id", "cell_id", "expected_cell_revision", "operation", "amount_milligrams", "transfer_id"],
  "properties": {
    "sequence": { "$ref": "#/$defs/positiveInteger" },
    "request_id": { "type": "string", "pattern": "^terrain-request-[1-9][0-9]{0,15}$" },
    "cell_id": { "$ref": "#/$defs/id" },
    "expected_cell_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "operation": { "enum": ["excavate", "fill"] },
    "amount_milligrams": { "$ref": "#/$defs/positiveInteger" },
    "transfer_id": { "type": "string" }
  },
  "oneOf": [
    { "properties": { "operation": { "const": "excavate" }, "transfer_id": { "const": "" } } },
    { "properties": { "operation": { "const": "fill" }, "transfer_id": { "$ref": "#/$defs/id" } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 }
  }
}

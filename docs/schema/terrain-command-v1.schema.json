{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-command:v1",
  "title": "Terrain server command intent (authenticated context remains server-local)",
  "type": "object",
  "required": ["schema_version", "request_number", "operation", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_number": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "operation": { "enum": ["excavate", "fill"] },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "operation": { "const": "excavate" } } }, "then": { "properties": { "payload": { "properties": { "transfer_id": { "const": "" } } } } } },
    { "if": { "properties": { "operation": { "const": "fill" } } }, "then": { "properties": { "payload": { "properties": { "transfer_id": { "pattern": "^terrain-transfer-[1-9][0-9]*$" } } } } } }
  ],
  "$defs": {
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "payload": {
      "type": "object",
      "required": ["cell_id", "expected_cell_revision", "amount_milligrams", "transfer_id", "expected_inventory_revision", "expected_tool_revision"],
      "properties": {
        "cell_id": { "enum": ["terrain.dirt.source", "terrain.dirt.fill"] },
        "expected_cell_revision": { "$ref": "#/$defs/revision" },
        "expected_inventory_revision": { "$ref": "#/$defs/revision" },
        "expected_tool_revision": { "$ref": "#/$defs/revision" },
        "amount_milligrams": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "transfer_id": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    }
  }
}

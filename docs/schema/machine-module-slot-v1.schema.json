{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:machine-module-slot:v1",
  "title": "Machine module slot definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slot_id", "interface_id", "capacity_units", "allowed_module_families"],
  "properties": {
    "schema_version": { "const": 1 },
    "slot_id": { "$ref": "#/$defs/id" },
    "interface_id": { "$ref": "#/$defs/id" },
    "capacity_units": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "allowed_module_families": {
      "description": "Physical bay family support. An asterisk permits every family on this interface; missing functional prerequisites do not prevent installation.",
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } }
}

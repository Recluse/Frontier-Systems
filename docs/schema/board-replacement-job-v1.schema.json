{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:board-replacement-job:v1",
  "title": "Reserved fixed-tick board replacement",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "actor_id", "target_board_id", "created_tick", "updated_tick", "completed_work_ticks", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "$ref": "#/$defs/id" }, "actor_id": { "$ref": "#/$defs/id" }, "target_board_id": { "$ref": "#/$defs/id" },
    "created_tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "updated_tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "completed_work_ticks": { "type": "integer", "minimum": 0, "maximum": 179 },
    "status": { "enum": ["active", "paused"] }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } }
}

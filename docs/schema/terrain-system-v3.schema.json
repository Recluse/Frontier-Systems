{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-system:v3",
  "title": "Finite terrain lifetime parcel lifecycle checkpoint",
  "description": "V1/v2 migrate active associations from canonical owner transfers. Permanent receipts are historical, never conserved mass. Active associations require physical bijection; returned ones require no physical item, immutable holder receipts and chronological fill permissions. Runtime validates relationships, exact provenance and bounded lifetime ordinals.",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_fingerprint",
    "last_tick",
    "owner",
    "positions",
    "principals",
    "requests",
    "claims",
    "portable"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "catalog_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "last_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "owner": {
      "$ref": "urn:frontier-systems:schema:terrain-material-owner:v1"
    },
    "positions": {
      "type": "object",
      "required": [
        "terrain.dirt.source",
        "terrain.dirt.fill"
      ],
      "properties": {
        "terrain.dirt.source": {
          "const": [
            0,
            0,
            1000
          ]
        },
        "terrain.dirt.fill": {
          "const": [
            500,
            0,
            1000
          ]
        }
      },
      "additionalProperties": false
    },
    "principals": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740990
      }
    },
    "requests": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "principal_id",
          "request_number",
          "owner_sequence",
          "intent"
        ],
        "properties": {
          "principal_id": {
            "$ref": "#/$defs/id"
          },
          "request_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "owner_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "intent": {
            "type": "object",
            "required": [
              "operation",
              "payload"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "excavate",
                  "fill"
                ]
              },
              "payload": {
                "$ref": "urn:frontier-systems:schema:terrain-command:v1#/$defs/payload"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^terrain-transfer-[1-9][0-9]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "portable": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^terrain-transfer-[1-9][0-9]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "item_id",
          "principal_id",
          "request_number",
          "expected_inventory_revision",
          "receipt",
          "returned"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^terrain-item-[1-9][0-9]*$",
            "maxLength": 128
          },
          "principal_id": {
            "$ref": "#/$defs/id"
          },
          "request_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "expected_inventory_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740989
          },
          "receipt": {
            "$ref": "urn:frontier-systems:schema:terrain-portable-receipt:v1"
          },
          "returned": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:frontier-systems:schema:terrain-return-receipt:v1"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    }
  }
}

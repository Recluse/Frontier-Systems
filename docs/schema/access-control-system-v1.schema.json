{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:access-control-system:v1",
  "title": "Frontier Systems access-control simulation system v1",
  "description": "Snapshot wrapper for per-device access-control, actuator, bypass-job, and tamper records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "devices"],
  "properties": {
    "schema_version": { "const": 1 },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "urn:frontier-systems:schema:access-control:v1" }
    }
  }
}

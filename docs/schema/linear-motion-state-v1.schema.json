{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:linear-motion-state:v1",
  "title": "Local-frame linear momentum state v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "body_id", "frame_id", "state_revision", "mass_milligrams", "linear_momentum_micro_ns"],
  "properties": {
    "schema_version": {"const": 1},
    "body_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "frame_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "mass_milligrams": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
    "linear_momentum_micro_ns": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "integer", "minimum": -1000000000000, "maximum": 1000000000000},
      "description": "Momentum in micro-newton-seconds (1e-6 N s); code additionally bounds local speed."
    }
  }
}

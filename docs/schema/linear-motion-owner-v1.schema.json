{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:linear-motion-owner:v1",
  "title": "Atomic paired-impulse motion owner v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "owner_id", "state_revision", "last_commit_tick", "states", "receipts"],
  "properties": {
    "schema_version": {"const": 1},
    "owner_id": {"$ref": "#/$defs/id"},
    "state_revision": {"$ref": "#/$defs/counter"},
    "last_commit_tick": {"$ref": "#/$defs/counter"},
    "states": {"type": "array", "maxItems": 64, "items": {"$ref": "urn:frontier-systems:schema:linear-motion-state:v1"}},
    "receipts": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "positive_counter": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "fingerprint", "actor_body_id", "target_body_id", "result_owner_revision", "actor_revision", "target_revision", "commit_tick"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_body_id": {"$ref": "#/$defs/id"},
        "target_body_id": {"$ref": "#/$defs/id"},
        "result_owner_revision": {"$ref": "#/$defs/positive_counter"},
        "actor_revision": {"$ref": "#/$defs/positive_counter"},
        "target_revision": {"$ref": "#/$defs/positive_counter"},
        "commit_tick": {"$ref": "#/$defs/positive_counter"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:overlay-section-profile:v1",
  "title": "HUD section order and collapse profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "definition_id", "display_name", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "definition_id": {"$ref": "#/$defs/id"},
    "display_name": {"$ref": "#/$defs/id"},
    "sections": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "collapsed"],
      "properties": {
        "section_id": {"$ref": "#/$defs/id"},
        "collapsed": {"type": "boolean"}
      }
    }}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}}
}

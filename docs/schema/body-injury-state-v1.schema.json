{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:body-injury-state:v1",
  "title": "Prototype human localized injury state v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "body_id", "state_revision", "last_changed_tick", "parts", "oxygen_damage_permille"],
  "properties": {
    "schema_version": {"const": 1},
    "body_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "last_changed_tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "oxygen_damage_permille": {"type": "integer", "minimum": 0, "maximum": 1000},
    "parts": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "torso", "arm.left", "arm.right", "leg.left", "leg.right"],
      "properties": {
        "head": {"$ref": "#/$defs/part"}, "torso": {"$ref": "#/$defs/part"},
        "arm.left": {"$ref": "#/$defs/part"}, "arm.right": {"$ref": "#/$defs/part"},
        "leg.left": {"$ref": "#/$defs/part"}, "leg.right": {"$ref": "#/$defs/part"}
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object", "additionalProperties": false, "required": ["blunt", "burn"],
      "properties": {"blunt": {"type": "integer", "minimum": 0, "maximum": 1000}, "burn": {"type": "integer", "minimum": 0, "maximum": 1000}}
    }
  },
  "description": "Fictional severity, not physiological measurements or impact energy. Code requires revision-zero anatomy healthy and changed anatomy a positive tick."
}

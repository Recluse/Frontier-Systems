{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:consciousness-assessment:v1",
  "title": "Trusted consciousness assessment request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "body_id", "expected_state_revision", "observed_tick", "causes"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "body_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "observed_tick": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "causes": {"$ref": "consciousness-causes-v1.schema.json"}
  },
  "description": "Internal trusted health adapter contract, not a player or LLM endpoint. New assessments require same-tick commit and current revision."
}

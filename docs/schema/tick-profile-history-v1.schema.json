{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:tick-profile-history:v1",
  "title": "Disposable bounded simulation profiling history",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "capacity", "retained_samples", "overwritten_samples", "samples"],
  "properties": {
    "schema_version": { "const": 1 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "retained_samples": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "overwritten_samples": { "type": "integer", "minimum": 0 },
    "samples": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/sample" } }
  },
  "$defs": {
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "tick_number", "elapsed_usec", "command_usec", "commands_processed", "queued_commands", "budget_usec", "over_budget", "systems"],
      "properties": {
        "schema_version": { "const": 1 },
        "tick_number": { "type": "integer", "minimum": 0 },
        "elapsed_usec": { "type": "integer", "minimum": 0 },
        "command_usec": { "type": "integer", "minimum": 0 },
        "commands_processed": { "type": "integer", "minimum": 0 },
        "queued_commands": { "type": "integer", "minimum": 0 },
        "budget_usec": { "type": "integer", "minimum": 1 },
        "over_budget": { "type": "boolean" },
        "systems": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/system" } }
      }
    },
    "system": {
      "type": "object", "additionalProperties": false,
      "required": ["system_id", "elapsed_usec", "counters"],
      "properties": {
        "system_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "elapsed_usec": { "type": "integer", "minimum": 0 },
        "counters": { "type": "object", "maxProperties": 16, "propertyNames": { "minLength": 1, "maxLength": 64 }, "additionalProperties": { "type": "number" } }
      }
    }
  }
}

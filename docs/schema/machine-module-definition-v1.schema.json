{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:machine-module-definition:v1",
  "title": "Machine module definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "revision", "module_family", "interface_id", "size_units", "idle_power_watts", "required_host_capabilities", "ports", "handler_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "definition_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "module_family": { "$ref": "#/$defs/id" },
    "interface_id": { "$ref": "#/$defs/id" },
    "size_units": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "idle_power_watts": { "type": "number", "minimum": 0 },
    "required_host_capabilities": {
      "description": "Functional prerequisites checked for operation, separately from physical installation compatibility.",
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "ports": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["port_id", "direction", "signal_type", "transport"],
        "properties": {
          "port_id": { "$ref": "#/$defs/id" },
          "direction": { "enum": ["input", "output"] },
          "signal_type": { "enum": ["pulse", "boolean", "number", "message"] },
          "transport": { "enum": ["wired", "radio"] }
        }
      }
    },
    "handler_id": { "$ref": "#/$defs/id" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:terrain-material-transfer-plan:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operation", "expected_cell_revision", "before", "after", "inventory_direction", "material_id", "material_revision", "amount_milligrams"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "enum": ["fill", "excavate"] },
    "expected_cell_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740989 },
    "before": { "$ref": "urn:frontier-systems:schema:terrain-material-state:v1" },
    "after": { "$ref": "urn:frontier-systems:schema:terrain-material-state:v1" },
    "inventory_direction": { "enum": ["consume", "produce"] },
    "material_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "material_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "amount_milligrams": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 }
  },
  "oneOf": [
    { "properties": { "operation": { "const": "fill" }, "inventory_direction": { "const": "consume" } } },
    { "properties": { "operation": { "const": "excavate" }, "inventory_direction": { "const": "produce" } } }
  ]
}

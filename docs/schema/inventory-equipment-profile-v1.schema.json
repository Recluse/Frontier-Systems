{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:inventory-equipment-profile:v1",
  "title": "Body inventory equipment profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "revision", "max_carried_mass_milligrams", "hand_slot_ids", "slots"],
  "properties": {
    "schema_version": {"const": 1},
    "definition_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "max_carried_mass_milligrams": {"$ref": "#/$defs/quantity"},
    "hand_slot_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "slots": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "accepted_tags", "max_mass_milligrams", "max_volume_millilitres"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "accepted_tags": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "max_mass_milligrams": {"$ref": "#/$defs/quantity"},
        "max_volume_millilitres": {"$ref": "#/$defs/quantity"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740990}
  }
}

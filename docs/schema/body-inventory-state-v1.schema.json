{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:body-inventory-state:v1",
  "title": "Combined body inventory and equipment state v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "body_id", "state_revision", "profile_id", "profile_revision", "body_container_id", "active_hand_slot_id", "equipped", "ledger"],
  "properties": {
    "schema_version": {"const": 1},
    "body_id": {"$ref": "#/$defs/id"},
    "state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "body_container_id": {"$ref": "#/$defs/id"},
    "active_hand_slot_id": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "equipped": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "item_id"],
      "properties": {"slot_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/id"}}
    }},
    "ledger": {"$ref": "urn:frontier-systems:schema:inventory-ledger:v1"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}}
}
